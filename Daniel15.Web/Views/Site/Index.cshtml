@model Daniel15.Web.ViewModels.Site.IndexViewModel
@{
	var devExperienceYears = (DateTime.Now - new DateTime(1998, 01, 01)).Years();
	var reactExperienceYears = (DateTime.Now - new DateTime(2013, 08, 01)).Years();
	
	Model.SidebarType = SidebarType.Right;
	Model.Heading = "Daniel15";
	Model.Description = "Website of Daniel15 (Daniel Lo Nigro). Here I blog about things important to me, and also link to the various other projects I'm working on.";
}

<div class="hero">
	<h1>Hi, I'm Daniel.</h1>
	<p>
		I'm a software developer with <span class="highlight-number">@devExperienceYears</span> years experience.
		Front-end is where I live, but I also develop using <span class="highlight-noun">C#</span> and
		<span class="highlight-noun">Hacklang</span>, build data pipelines with
		<span class="highlight-noun">Presto</span> and <span class="highlight-noun">Apache Airflow</span>, and look
		after a handful of <span class="highlight-noun">Debian</span> servers.

		I've been working on open-source software <a href="https://github.com/Daniel15/DanPHPSupport/">since 2005</a>,
		including notable projects such as React, Babel, ASP.NET Core, and Yarn v1.

		I currently work at <a href="https://www.meta.com/" rel="nofollow">Meta</a>.
	</p>
</div>

<partial name="_LatestPosts" model="Model.LatestPosts" />

<section class="contact-section">
	<div>
		<h2>Elsewhere</h2>
		<partial name="_ContactMeLinks"/>
	</div>

	<div class="card">
		<h2>What I've been doing</h2>
		<ul class="minifeed">
			<li class="minifeed-loading">Loading...</li>
		</ul>

		<a class="minifeed-more" href="socialfeed.htm">See more...</a>
	</div>
</section>
