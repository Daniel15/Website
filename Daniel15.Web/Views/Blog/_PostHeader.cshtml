@using Daniel15.Web.ViewModels.Shared
@model Daniel15.Web.ViewModels.Blog.PostViewModel
<header>
	<ul class="postmetadata">
		<li><a class="category" href="@Url.BlogCategory(Model.Post.MainCategory)" itemprop="keywords">@Model.Post.MainCategory.Title</a></li>
		<li class="date"><partial name="_Timestamp" model="@(new TimestampViewModel(Model.Post.Date, ItemProp: "datePublished"))" /></li>
	</ul>
	<h1 itemprop="name">@Model.Post.Title</h1>
</header>
<div itemprop="articleBody">
